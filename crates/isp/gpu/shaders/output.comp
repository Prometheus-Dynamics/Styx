#version 450
// Output stages, the output format (`styx-softisp`'s `post::write_output`): the picture's
// planes, from (`crop_x`, `crop_y`), converted to RGB (JFIF inverse) and then to RGB24, luma,
// or 4:2:0 (each 2x2 block's chroma from the rounded mean of its RGB). Each invocation makes a
// 2x2 block of output pixels.

#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0, std430) readonly buffer Src {
    uint8_t src[];
};

layout(set = 2, binding = 0, std430) writeonly buffer Out {
    uint8_t outb[];
};

void put(uint plane, uint x, uint y, uint v) {
    outb[P.out_offset[plane] + y * P.out_stride[plane] + x] = uint8_t(v);
}

// The RGB of picture pixel (x, y).
uvec3 picture(uint x, uint y) {
    uint plane = P.pic_w * P.pic_h;
    uint i = y * P.pic_w + x;
    return rgb_of(uint(src[i]), uint(src[plane + i]), uint(src[2u * plane + i]));
}

void main() {
    uint x0 = gl_GlobalInvocationID.x * 2u;
    uint y0 = gl_GlobalInvocationID.y * 2u;
    if (x0 >= P.out_width || y0 >= P.out_height) {
        return;
    }
    uvec3 px[4];
    bool inside[4];
    for (uint k = 0u; k < 4u; k++) {
        uint ox = x0 + (k & 1u), oy = y0 + (k >> 1);
        inside[k] = ox < P.out_width && oy < P.out_height;
        px[k] = inside[k] ? picture(P.crop_x + ox, P.crop_y + oy) : uvec3(0u);
    }
    if (P.out_kind == OUT_RGB24) {
        for (uint k = 0u; k < 4u; k++) {
            if (inside[k]) {
                uint x = (x0 + (k & 1u)) * 3u, y = y0 + (k >> 1);
                put(0u, x, y, px[k].r);
                put(0u, x + 1u, y, px[k].g);
                put(0u, x + 2u, y, px[k].b);
            }
        }
        return;
    }
    for (uint k = 0u; k < 4u; k++) {
        if (inside[k]) {
            put(0u, x0 + (k & 1u), y0 + (k >> 1), luma8(px[k]));
        }
    }
    if (P.out_kind == OUT_LUMA) {
        return;
    }
    // 4:2:0 outputs have even sizes, so the whole block is inside.
    ivec3 m = (ivec3(px[0] + px[1] + px[2] + px[3]) + 2) >> 2;
    uint cb = chroma8(m, false), cr = chroma8(m, true);
    if (P.out_kind == OUT_NV12) {
        put(1u, x0, y0 >> 1, cb);
        put(1u, x0 + 1u, y0 >> 1, cr);
    } else {
        put(1u, x0 >> 1, y0 >> 1, cb);
        put(2u, x0 >> 1, y0 >> 1, cr);
    }
}

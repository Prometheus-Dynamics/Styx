#version 450
// Exhaustive whole-pel motion search for an H.264 encoder, as
// `styx_core::simd::h264::full_search` computes it: one workgroup per 16x16 macroblock, which
// keeps the macroblock and its reference window in shared memory and tries every offset up to
// `range` either way with the block inside the picture. Least SAD wins, ties to the least
// `|dx| + |dy|`, then the first candidate in raster order. `src/h264.rs` lays the buffers out.
//
// Output: two words per macroblock (row-major): the winner's key (`tie << 11 | candidate`,
// candidate `(dy + range) * (2 range + 1) + dx + range`), then its SAD.

#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Src {
    uint8_t src[];
};

layout(set = 0, binding = 1, std430) writeonly buffer Dst {
    uint dst[];
};

// The 18 words `GpuConvert` pushes; the first five used here.
layout(push_constant, std430) uniform Args {
    // Macroblocks a row and rows; the planes' width (their row stride) and height in samples.
    uint mb_w;
    uint mb_h;
    uint width;
    uint height;
    // Byte offset of the reference plane in `src` (the current one is at 0), and the range.
    uint ref_off;
    uint range;
    uint unused6;
    uint unused7;
    uint unused8;
    uint unused9;
    uint unused10;
    uint unused11;
    uint unused12;
    uint unused13;
    uint unused14;
    uint unused15;
    uint unused16;
    uint unused17;
} A;

const int RMAX = 16;
const int WIN = 16 + 2 * RMAX;

shared uint cur[256];
shared uint win[WIN * WIN];
shared uint best_sad;
shared uint best_key;

void main() {
    uint t = gl_LocalInvocationIndex;
    int x0 = int(gl_WorkGroupID.x) * 16;
    int y0 = int(gl_WorkGroupID.y) * 16;
    int w = int(A.width);
    int h = int(A.height);
    int r = int(A.range);
    int side = 16 + 2 * r;
    for (uint i = t; i < 256u; i += 64u) {
        cur[i] = uint(src[(y0 + int(i / 16u)) * w + x0 + int(i % 16u)]);
    }
    for (uint i = t; i < uint(side * side); i += 64u) {
        int x = x0 - r + int(i) % side;
        int y = y0 - r + int(i) / side;
        bool inside = x >= 0 && y >= 0 && x < w && y < h;
        win[i] = inside ? uint(src[A.ref_off + uint(y * w + x)]) : 0u;
    }
    if (t == 0u) {
        best_sad = 0xffffffffu;
        best_key = 0xffffffffu;
    }
    barrier();

    int d = 2 * r + 1;
    uint my_sad = 0xffffffffu;
    uint my_key = 0xffffffffu;
    for (int c = int(t); c < d * d; c += 64) {
        int dx = c % d - r;
        int dy = c / d - r;
        int rx = x0 + dx;
        int ry = y0 + dy;
        if (rx < 0 || ry < 0 || rx + 16 > w || ry + 16 > h) {
            continue;
        }
        uint sad = 0u;
        int base = (dy + r) * side + dx + r;
        for (int row = 0; row < 16; row++) {
            for (int col = 0; col < 16; col++) {
                int a = int(cur[row * 16 + col]);
                int b = int(win[base + row * side + col]);
                sad += uint(abs(a - b));
            }
        }
        uint key = (uint(abs(dx) + abs(dy)) << 11) | uint(c);
        if (sad < my_sad || (sad == my_sad && key < my_key)) {
            my_sad = sad;
            my_key = key;
        }
    }
    atomicMin(best_sad, my_sad);
    barrier();
    if (my_sad == best_sad) {
        atomicMin(best_key, my_key);
    }
    barrier();
    if (t == 0u) {
        uint mb = gl_WorkGroupID.y * A.mb_w + gl_WorkGroupID.x;
        dst[2u * mb] = best_key;
        dst[2u * mb + 1u] = best_sad;
    }
}

#version 450
// Full-size output in fp16 (`fp16.glsl`): the tile holds fp16 working values (exact in floats),
// the bilinear demosaic, colour matrix and tone curve run in float16, and the output conversion
// is `full.comp`'s. Each invocation makes one 2x2 block of pixels (one 4:2:0 chroma sample).

#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "fp16.glsl"

layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;

layout(set = 2, binding = 0, std430) writeonly buffer Out {
    uint8_t outb[];
};

const int TW = 36;
const int TH = 20;
shared float tile[TH * TW];

float16_t t16(int x, int y) {
    return float16_t(tile[y * TW + x]);
}

// `full.comp`'s bilinear at tile position (x, y) in float16.
f16vec3 bilinear16(int x, int y, uint px, uint py) {
    float16_t c = t16(x, y);
    float16_t h = (t16(x - 1, y) + t16(x + 1, y)) * float16_t(0.5);
    float16_t v = (t16(x, y - 1) + t16(x, y + 1)) * float16_t(0.5);
    float16_t gv, xv, yv;
    if ((px == 0u) == (P.green_even[py] != 0u)) {
        gv = c;
        xv = h;
        yv = v;
    } else {
        float16_t d = (t16(x - 1, y - 1) + t16(x + 1, y - 1) + t16(x - 1, y + 1) + t16(x + 1, y + 1))
            * float16_t(0.25);
        gv = (h + v) * float16_t(0.5);
        xv = c;
        yv = d;
    }
    return P.x_is_red[py] != 0u ? f16vec3(xv, gv, yv) : f16vec3(yv, gv, xv);
}

// `full.comp`'s luma from the mosaic, the 3x3 binomial filter (sums in float, as they reach
// 16 times full scale).
uint bayer_luma16(int x, int y) {
    float s = 0.0;
    for (int dx = -1; dx <= 1; dx++) {
        float vs = float(t16(x + dx, y - 1)) + 2.0 * float(t16(x + dx, y)) + float(t16(x + dx, y + 1));
        s += dx == 0 ? 2.0 * vs : vs;
    }
    return tone(uint(clamp(s * (1.0 / 16.0) + 0.5, 0.0, 4095.0)));
}

void put(uint plane, uint x, uint y, uint v) {
    outb[P.out_offset[plane] + y * P.out_stride[plane] + x] = uint8_t(v);
}

void main() {
    // Frame coordinates of the tile's first sample: the window origin, the workgroup's block,
    // and a 2-sample border (reflected at the frame's edges, not the window's).
    ivec2 origin = ivec2(P.win_x, P.win_y) + ivec2(gl_WorkGroupID.xy) * ivec2(32, 16) - 2;
    for (uint i = gl_LocalInvocationIndex; i < uint(TW * TH); i += 128u) {
        int tx = int(i) % TW;
        int ty = int(i) / TW;
        tile[i] = float(front16(reflect_into(origin.x + tx, P.width), reflect_into(origin.y + ty, P.height)));
    }
    barrier();
    uint x0 = gl_GlobalInvocationID.x * 2u;
    uint y0 = gl_GlobalInvocationID.y * 2u;
    if (x0 >= P.out_width || y0 >= P.out_height) {
        return;
    }
    int lx = int(gl_LocalInvocationID.x) * 2 + 2;
    int ly = int(gl_LocalInvocationID.y) * 2 + 2;
    if (P.out_kind == OUT_LUMA) {
        for (uint k = 0u; k < 4u; k++) {
            uint dx = k & 1u, dy = k >> 1;
            put(0u, x0 + dx, y0 + dy, bayer_luma16(lx + int(dx), ly + int(dy)));
        }
        return;
    }
    uvec3 px[4];
    for (uint k = 0u; k < 4u; k++) {
        uint dx = k & 1u, dy = k >> 1;
        // Colour parities of the frame's samples (the window's origin is even).
        uint cx = (P.win_x + x0 + dx) & 1u, cy = (P.win_y + y0 + dy) & 1u;
        px[k] = tone16(colour16(bilinear16(lx + int(dx), ly + int(dy), cx, cy)));
    }
    if (P.out_kind == OUT_RGB24) {
        for (uint k = 0u; k < 4u; k++) {
            uint x = (x0 + (k & 1u)) * 3u, y = y0 + (k >> 1);
            put(0u, x, y, px[k].r);
            put(0u, x + 1u, y, px[k].g);
            put(0u, x + 2u, y, px[k].b);
        }
        return;
    }
    for (uint k = 0u; k < 4u; k++) {
        put(0u, x0 + (k & 1u), y0 + (k >> 1), luma8(px[k]));
    }
    ivec3 m = (ivec3(px[0] + px[1] + px[2] + px[3]) + 2) >> 2;
    uint cb = chroma8(m, false), cr = chroma8(m, true);
    if (P.out_kind == OUT_NV12) {
        put(1u, x0, y0 >> 1, cb);
        put(1u, x0 + 1u, y0 >> 1, cr);
    } else {
        put(1u, x0 >> 1, y0 >> 1, cb);
        put(2u, x0 >> 1, y0 >> 1, cr);
    }
}

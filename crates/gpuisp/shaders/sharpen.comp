#version 450
// Output stages, sharpening (`styx-softisp`'s `post::sharpen_band`): the unsharp mask on the
// luma plane, `Y + amount * (Y - blur(Y))` with the detail cored by the threshold and the
// correction limited, the blur `[1 2 1] x [1 2 1] / 16` with the edges reflected. The chroma
// planes are copied. Planes as in `denoise.comp`.

#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 1, binding = 0, std430) readonly buffer Src {
    uint8_t src[];
};

layout(set = 2, binding = 0, std430) writeonly buffer Dst {
    uint8_t dst[];
};

int at(uint k, uint x, uint y) {
    return int(uint(src[k * P.pic_w * P.pic_h + y * P.pic_w + x]));
}

// The column sum `up + 2 cur + dn` of the luma at column `x` (rows `u`, `y`, `d`).
int vsum(uint x, uint u, uint y, uint d) {
    return at(0u, x, u) + 2 * at(0u, x, y) + at(0u, x, d);
}

// `post::sharpen_at` of the luma sample at (x, y).
int sharpen_luma(uint x, uint y) {
    uint l = reflect_into(int(x) - 1, P.pic_w), r = reflect_into(int(x) + 1, P.pic_w);
    uint u = reflect_into(int(y) - 1, P.pic_h), d = reflect_into(int(y) + 1, P.pic_h);
    int c = at(0u, x, y);
    int blur = (vsum(l, u, y, d) + 2 * vsum(x, u, y, d) + vsum(r, u, y, d) + 8) >> 4;
    int detail = c - blur;
    int cored = sign(detail) * max(abs(detail) - P.sharpen_threshold, 0);
    int corr = clamp((P.sharpen_amount * cored + 128) >> 8, -P.sharpen_limit, P.sharpen_limit);
    return clamp(c + corr, 0, 255);
}

void main() {
    uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
    if (x >= P.pic_w || y >= P.pic_h) {
        return;
    }
    uint plane = P.pic_w * P.pic_h;
    for (uint k = 0u; k < 3u; k++) {
        int v = at(k, x, y);
        if (k == 0u && P.sharpen_on != 0u) {
            v = sharpen_luma(x, y);
        }
        dst[k * plane + y * P.pic_w + x] = uint8_t(v);
    }
}
